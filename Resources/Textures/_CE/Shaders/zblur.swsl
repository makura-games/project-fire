uniform sampler2D SCREEN_TEXTURE;
uniform highp vec3 BLUR_COLOR;

const highp float darken_strength = 0.3; // Darkness level 0.0 to 1.0
const highp float blur_radius = 2.0; // Blur radius from 0.0 to 10.0

void fragment() {
    highp vec4 blurred_color = vec4(0.0);
    for (lowp int x = -1; x <= 1; x++) {
        for (lowp int y = -1; y <= 1; y++) {
            blurred_color += texture(SCREEN_TEXTURE, UV + vec2(x, y) * SCREEN_PIXEL_SIZE * blur_radius);
        }
    }
    blurred_color /= 9.0;

    // Fire edit start - учитываем прозрачность при совмещении этажей, чтобы стекло сохраняло свой цвет.
    // После рисования на прозрачном чёрном фоне RGB уже умножен на покрытие.
    // Финальный проход сам умножит RGB на alpha при смешивании этажей.
    if (blurred_color.a > 0.00001) {
        blurred_color.rgb /= blurred_color.a;
    } else {
        blurred_color.rgb = vec3(0.0);
    }
    // Fire edit end

    highp vec3 shadow = mix(vec3(1.0), BLUR_COLOR, darken_strength);
    blurred_color.rgb *= shadow;

    COLOR = blurred_color;
}
