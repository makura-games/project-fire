uniform highp vec3 FOG_COLOR;
uniform highp vec2 corner_bl;
uniform highp vec2 corner_br;
uniform highp vec2 corner_tl;
uniform highp vec2 corner_tr;
uniform highp vec2 wind_offset;
uniform highp vec2 seed_offset;
uniform highp float time_z;
uniform highp float fog_amount;

const highp float fog_frequency = 0.185;
const highp float fog_noise_strength = 0.25;

highp float fogHash(highp vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 19.19);
    return fract((p.x + p.y) * p.z);
}

highp float fogNoise(highp vec3 p)
{
    highp vec3 i = floor(p);
    highp vec3 f = fract(p);
    highp vec3 u = f * f * (3.0 - 2.0 * f);

    highp float n000 = fogHash(i + vec3(0.0, 0.0, 0.0));
    highp float n100 = fogHash(i + vec3(1.0, 0.0, 0.0));
    highp float n010 = fogHash(i + vec3(0.0, 1.0, 0.0));
    highp float n110 = fogHash(i + vec3(1.0, 1.0, 0.0));
    highp float n001 = fogHash(i + vec3(0.0, 0.0, 1.0));
    highp float n101 = fogHash(i + vec3(1.0, 0.0, 1.0));
    highp float n011 = fogHash(i + vec3(0.0, 1.0, 1.0));
    highp float n111 = fogHash(i + vec3(1.0, 1.0, 1.0));

    highp float nx00 = mix(n000, n100, u.x);
    highp float nx10 = mix(n010, n110, u.x);
    highp float nx01 = mix(n001, n101, u.x);
    highp float nx11 = mix(n011, n111, u.x);

    highp float nxy0 = mix(nx00, nx10, u.y);
    highp float nxy1 = mix(nx01, nx11, u.y);

    return mix(nxy0, nxy1, u.z);
}

void fragment() {
    highp vec2 world_pos = mix(mix(corner_bl, corner_br, UV.x), mix(corner_tl, corner_tr, UV.x), UV.y);
    highp vec3 sample_pos = vec3((world_pos + wind_offset + seed_offset) * fog_frequency, time_z);
    highp float n = fogNoise(sample_pos);

    highp float amount = clamp(fog_amount + (n - 0.5) * fog_noise_strength, 0.0, 1.0);

    // Lighting/FOV are applied by the engine after this draw (WorldSpaceBelowFOV).
    COLOR = vec4(FOG_COLOR, amount);
}
