<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client._Scp.Amnesiac.AmnesiacInfoWindow"
               Title="{Loc 'amnesiac-info-title'}"
               MinSize="380 200">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10"
                  SeparationOverride="10">
        <RichTextLabel Name="UsedLabel" HorizontalExpand="True" />
        <RichTextLabel Name="ErasedLabel" HorizontalExpand="True" />
        <RichTextLabel Text="{Loc 'amnesiac-info-ooc'}" HorizontalExpand="True" />
        <Button Name="OkButton" HorizontalAlignment="Center" MinWidth="120" Disabled="True" />
    </BoxContainer>
</DefaultWindow>
